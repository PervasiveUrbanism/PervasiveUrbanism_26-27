  <tag k="charge:city_bike" v="1.65 GBP/30 minutes"/>
  <tag k="charge:description" v="£1.65 for each 30m ride. Day Pass for £3 (unlimited 30-minute rides; £1 extra for each e-bike ride). Monthly membership for £20 which offers unlimited rides up to 60 minutes for 30 days."/>
